{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyfgsea.local/schemas/t21_calibration_blind_bindings_v2.schema.json",
  "title": "T21 strict blind calibration bindings v2",
  "type": "object",
  "required": [
    "bindings_schema_version",
    "analysis_plan_sha256",
    "calibration_policy_sha256",
    "runner_spec_sha256",
    "calibration_report_schema_sha256",
    "design_profile_sha256",
    "design_profile_payload_sha256",
    "scrna_sha256",
    "donor_design_sha256",
    "fates_sha256",
    "scrna_cell_id_set_hash",
    "scrna_gene_order_hash",
    "donor_set_hash",
    "scrna_donor_set_hash",
    "expression_contract_sha256",
    "expression_implementation_source_sha256",
    "expression_csr_semantic_sha256",
    "formal_analysis_cell_set_hash",
    "formal_analysis_cell_order_hash",
    "formal_analysis_cell_count",
    "formal_gene_order_bound_support_sha256",
    "formal_support_contract_sha256",
    "formal_support_mask_sha256_uint8",
    "formal_analysis_cell_mask_sha256_uint8",
    "trajectory_tree_digest_sha256",
    "trajectory_grid_hash",
    "trajectory_primary_draw_id_sha256",
    "pathway_universe_sha256",
    "pathway_universe_logical_sha256",
    "supported_pathway_universe_logical_sha256",
    "code_commit",
    "code_dirty"
  ],
  "properties": {
    "bindings_schema_version": {"const": "2.0.0"},
    "formal_analysis_cell_count": {"type": "integer", "minimum": 1},
    "formal_support_mask_sha256_uint8": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formal_analysis_cell_mask_sha256_uint8": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_dirty": {"type": "boolean"},
    "code_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "patternProperties": {
    ".*_sha256$": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    ".*_hash$": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"code_dirty": {"const": true}}},
      "then": {"required": ["code_patch_sha256"]},
      "else": {"not": {"required": ["code_patch_sha256"]}}
    }
  ]
}
