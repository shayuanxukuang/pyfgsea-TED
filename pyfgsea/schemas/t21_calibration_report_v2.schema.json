{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyfgsea.local/schemas/t21_calibration_report_v2.schema.json",
  "title": "T21 profile-parameterized pre-unblinding calibration report v2",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "report_id",
    "created_at_utc",
    "outcome_blinded",
    "calibration_stage",
    "publication_minima_satisfied",
    "input_bindings",
    "design_profile_usage",
    "scenario_metrics",
    "power_metrics",
    "execution",
    "output_artifacts"
  ],
  "properties": {
    "schema_name": {"const": "t21_pre_unblinding_calibration_report"},
    "schema_version": {"type": "string", "pattern": "^2\\."},
    "report_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "outcome_blinded": {"const": true},
    "calibration_stage": {"const": "final"},
    "publication_minima_satisfied": {"const": true},
    "input_bindings": {
      "type": "object",
      "required": [
        "bindings_schema_version",
        "analysis_plan_sha256",
        "calibration_policy_sha256",
        "runner_spec_sha256",
        "calibration_report_schema_sha256",
        "design_profile_sha256",
        "design_profile_payload_sha256",
        "scrna_sha256",
        "donor_design_sha256",
        "fates_sha256",
        "scrna_cell_id_set_hash",
        "scrna_gene_order_hash",
        "donor_set_hash",
        "scrna_donor_set_hash",
        "expression_contract_sha256",
        "expression_implementation_source_sha256",
        "expression_csr_semantic_sha256",
        "formal_analysis_cell_set_hash",
        "formal_analysis_cell_order_hash",
        "formal_analysis_cell_count",
        "formal_gene_order_bound_support_sha256",
        "formal_support_contract_sha256",
        "formal_support_mask_sha256_uint8",
        "formal_analysis_cell_mask_sha256_uint8",
        "trajectory_tree_digest_sha256",
        "trajectory_grid_hash",
        "trajectory_primary_draw_id_sha256",
        "pathway_universe_sha256",
        "pathway_universe_logical_sha256",
        "supported_pathway_universe_logical_sha256",
        "code_commit",
        "code_dirty"
      ],
      "properties": {
        "bindings_schema_version": {"const": "2.0.0"},
        "formal_analysis_cell_count": {"type": "integer", "minimum": 1},
        "formal_support_mask_sha256_uint8": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "formal_analysis_cell_mask_sha256_uint8": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "code_dirty": {"type": "boolean"}
      },
      "patternProperties": {
        ".*_sha256$": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        ".*_hash$": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "design_profile_usage": {
      "type": "object",
      "required": [
        "profile_file_sha256",
        "profile_payload_sha256",
        "derived_parameters_sha256",
        "fixed_common_grid_bins",
        "selected_common_grid_bins",
        "selected_bin_mask_sha256",
        "fixed_20_bin_source_grid_verified",
        "selected_support_design_valid",
        "canonical_donor_design_spec_sha256",
        "canonical_reduced_design_sha256",
        "canonical_terms_sha256",
        "canonical_encoding_sha256",
        "sensitivity_signature_matrix_sha256",
        "n_sensitivity_signature_components",
        "covariate_stress_signature_effect_injected",
        "trajectory_grid_hash",
        "raw_rows_carry_profile_and_parameter_hashes"
      ],
      "properties": {
        "profile_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "derived_parameters_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixed_common_grid_bins": {"const": 20},
        "selected_common_grid_bins": {"type": "integer", "minimum": 2, "maximum": 20},
        "selected_bin_mask_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixed_20_bin_source_grid_verified": {"const": true},
        "selected_support_design_valid": {"const": true},
        "canonical_donor_design_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_reduced_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_terms_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_encoding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sensitivity_signature_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "n_sensitivity_signature_components": {"type": "integer", "minimum": 1, "maximum": 3},
        "covariate_stress_signature_effect_injected": {"const": true},
        "trajectory_grid_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_rows_carry_profile_and_parameter_hashes": {"const": true}
      },
      "additionalProperties": false
    },
    "scenario_metrics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["scenario", "n_replicates", "pointwise_curve_coverage"],
        "properties": {
          "scenario": {"type": "string"},
          "n_replicates": {"type": "integer", "minimum": 1},
          "pointwise_curve_coverage": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "power_metrics": {
      "type": "object",
      "required": [
        "n_replicates_per_point",
        "target_effect_standardized",
        "power_at_target_effect",
        "minimum_detectable_effect_standardized",
        "minimum_resolvable_onset_shift",
        "leave_one_control_out_power",
        "extreme_donor_empirical_fwer"
      ],
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": [
        "real_pathway_results_read",
        "phase",
        "development_override",
        "seed",
        "chunk_size",
        "publication_runner_benchmark",
        "design_profile_used",
        "design_profile_payload_sha256",
        "derived_design_parameters_sha256",
        "n_curve_bins",
        "selected_n_curve_bins",
        "condition_label_space_size",
        "label_space_exhaustive",
        "finite_sample_exactness_with_continuous_covariates_claimed",
        "exactness_statement",
        "formal_regulation_shared_kernel_used",
        "formal_timing_shared_kernel_used",
        "formal_power_shared_kernel_used",
        "formal_loco_shared_kernel_used",
        "formal_loco_fixed_s_support_gate_used",
        "vectorized_shared_freedman_lane_batch_used",
        "mapping_batch_size",
        "maximum_replicate_chunk_size",
        "formal_occupancy_fate_decomposition_kernel_used",
        "shared_state_population_draw_used",
        "chr21_gene_level_total_trans_projection_used",
        "fixed_20_bin_source_grid_verified",
        "selected_support_design_valid",
        "canonical_donor_design_spec_sha256",
        "canonical_reduced_design_sha256",
        "canonical_terms_sha256",
        "canonical_encoding_sha256",
        "sensitivity_signature_matrix_sha256",
        "n_sensitivity_signature_components",
        "covariate_stress_signature_effect_injected",
        "onset_interval_coverage_evaluated",
        "onset_confidence_interval_claim_unlocked",
        "onset_recovery_tolerance",
        "power_target_effect_standardization_sd"
      ],
      "properties": {
        "real_pathway_results_read": {"const": false},
        "phase": {"const": "final"},
        "development_override": {"const": false},
        "seed": {"const": 20260713},
        "chunk_size": {"const": 32},
        "publication_runner_benchmark": {
          "type": "object",
          "required": [
            "wall_clock_seconds",
            "replicate_work_units",
            "replicate_work_units_per_second",
            "seed",
            "chunk_size",
            "vectorized_shared_freedman_lane_batch_used",
            "mapping_batch_size"
          ],
          "properties": {
            "wall_clock_seconds": {"type": "number", "exclusiveMinimum": 0},
            "replicate_work_units": {"type": "integer", "minimum": 1},
            "replicate_work_units_per_second": {"type": "number", "exclusiveMinimum": 0},
            "seed": {"const": 20260713},
            "chunk_size": {"const": 32},
            "vectorized_shared_freedman_lane_batch_used": {"const": true},
            "mapping_batch_size": {"const": 16}
          },
          "additionalProperties": false
        },
        "design_profile_used": {"const": true},
        "n_curve_bins": {"const": 20},
        "selected_n_curve_bins": {"type": "integer", "minimum": 2, "maximum": 20},
        "condition_label_space_size": {"const": 680},
        "label_space_exhaustive": {"const": true},
        "finite_sample_exactness_with_continuous_covariates_claimed": {"const": false},
        "exactness_statement": {"type": "string", "minLength": 40},
        "formal_regulation_shared_kernel_used": {"const": true},
        "formal_timing_shared_kernel_used": {"const": true},
        "formal_power_shared_kernel_used": {"const": true},
        "formal_loco_shared_kernel_used": {"const": true},
        "formal_loco_fixed_s_support_gate_used": {"const": true},
        "vectorized_shared_freedman_lane_batch_used": {"const": true},
        "mapping_batch_size": {"const": 16},
        "maximum_replicate_chunk_size": {"const": 32},
        "formal_occupancy_fate_decomposition_kernel_used": {"const": true},
        "shared_state_population_draw_used": {"const": true},
        "chr21_gene_level_total_trans_projection_used": {"const": true},
        "fixed_20_bin_source_grid_verified": {"const": true},
        "selected_support_design_valid": {"const": true},
        "canonical_donor_design_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_reduced_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_terms_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_encoding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sensitivity_signature_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "n_sensitivity_signature_components": {"type": "integer", "minimum": 1, "maximum": 3},
        "covariate_stress_signature_effect_injected": {"const": true},
        "onset_interval_coverage_evaluated": {"const": false},
        "onset_confidence_interval_claim_unlocked": {"const": false},
        "onset_recovery_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "power_target_effect_standardization_sd": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "output_artifacts": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": ["role", "relative_path", "bytes", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
